{
  "title": "Almedia: outbound GTM system",
  "subtitle": "Work in progress, from context/docs/gtm-system.md. Row 1 reads left to right, row 2 right to left, row 3 left to right.",
  "rows": [
    {"title": "Signals, companies and ICP fit", "direction": "ltr", "columns": ["1A", "1B", "1C", "1D", "1E", "1F", "1G", "1H", "1I"]},
    {"title": "Route, people, emails and copy", "direction": "rtl", "columns": ["2A", ["2B", "2C", "2D"], "2E", "2F", "2G", "2H"]},
    {"title": "Send, replies, CRM and weekly loop", "direction": "ltr", "columns": ["3A", "3B", ["o1", "o2", "o3", "o4", "o5"], ["a1", "a2", "a3", "a4", "a5"], "3C", "3D"]}
  ],
  "nodes": {
    "1A": {"kind": "start", "title": "Context OS", "sub": "ICP, personas, signal matrix, messaging, facts.md", "tools": ["claude_code", "github"], "w": 300},
    "1B": {"kind": "step", "title": "Buying signals", "sub": ["Named by a rival rewarded network", "UA event speaker", "Hiring UA roles", "New Tier-1 market launch", "Publisher ships new title", "New UA leader"], "tools": ["n8n", "clay"]},
    "1C": {"kind": "decision", "title": "New signal?"},
    "skip": {"kind": "exit", "title": "Skip: seen in 90 days", "below": "1C"},
    "1D": {"kind": "step", "title": "Find companies", "sub": "Game or studio name to domain", "tools": ["clay"]},
    "1E": {"kind": "decision", "title": "Domain found?"},
    "rev": {"kind": "exit", "title": "Needs review, 2 weeks", "below": "1E"},
    "1F": {"kind": "step", "title": "Enrich", "sub": "Genre, live titles, markets, region, IAP, headcount", "tools": ["clay"]},
    "1G": {"kind": "decision", "title": "ICP fit?"},
    "drop": {"kind": "exit", "title": "Drop, or park non-gaming", "below": "1G"},
    "1H": {"kind": "decision", "title": "Monetizing?"},
    "notready": {"kind": "exit", "title": "Not ready, recheck 90 days", "below": "1H"},
    "1I": {"kind": "decision", "title": "In HubSpot?"},
    "owner": {"kind": "exit", "title": "Customer or open deal: alert owner", "below": "1I"},
    "2A": {"kind": "decision", "title": "Segment?"},
    "2B": {"kind": "branch", "title": "S1 Rival rewarded users", "sub": "Freecash, long-window angle", "w": 260},
    "2C": {"kind": "branch", "title": "S2 Scaling studios", "sub": "First rewarded partner", "w": 260},
    "2D": {"kind": "branch", "title": "S3 Multi-title publishers", "sub": "Link first", "w": 260},
    "2E": {"kind": "step", "title": "Find people", "sub": "UA Manager first, then CEO or COO, then Marketing Director", "tools": ["clay"], "w": 260},
    "2F": {"kind": "decision", "title": "Email valid?"},
    "li": {"kind": "exit", "title": "LinkedIn only", "below": "2F"},
    "2G": {"kind": "step", "title": "Write the sequence", "sub": "Workflow spec and copy from facts.md only", "tools": ["claude_code", "github"], "w": 260},
    "2H": {"kind": "decision", "title": "Approved?"},
    "edits": {"kind": "exit", "title": "Back for edits", "below": "2H"},
    "3A": {"kind": "step", "title": "Send the sequence", "sub": "3 emails plus 2 LinkedIn tasks", "tools": ["plusvibe", "hubspot"]},
    "3B": {"kind": "decision", "title": "Reply type?"},
    "o1": {"kind": "branch", "title": "Interested", "h": 80},
    "o2": {"kind": "branch", "title": "Says if they run rewarded", "h": 80},
    "o3": {"kind": "branch", "title": "Objection", "h": 80},
    "o4": {"kind": "branch", "title": "Not now", "h": 80},
    "o5": {"kind": "branch", "title": "Unsubscribe or bounce", "h": 80},
    "a1": {"kind": "step", "title": "Deal: meeting requested", "w": 300, "h": 80, "tools": ["hubspot"]},
    "a2": {"kind": "step", "title": "Yes: move S2 to S1 angle", "w": 300, "h": 80, "tools": ["n8n"]},
    "a3": {"kind": "step", "title": "Rep answers from competitors.md", "w": 300, "h": 80},
    "a4": {"kind": "step", "title": "Re-contact in 90 days", "w": 300, "h": 80, "tools": ["hubspot"]},
    "a5": {"kind": "step", "title": "Suppress everywhere", "w": 300, "h": 80, "tools": ["plusvibe"]},
    "3C": {"kind": "step", "title": "Pipeline", "sub": ["Meeting held", "Test campaign live", "Scaling or lost"], "tools": ["hubspot"]},
    "3D": {"kind": "start", "title": "Weekly review", "sub": "Replies and meetings by signal, segment and persona", "tools": ["n8n", "claude_code"], "w": 300, "align": "bottom"}
  },
  "edges": [
    ["1A", "1B"], ["1B", "1C"], ["1C", "1D", "Yes"], ["1C", "skip", "No"],
    ["1D", "1E"], ["1E", "1F", "Yes"], ["1E", "rev", "No"],
    ["1F", "1G"], ["1G", "1H", "Yes"], ["1G", "drop", "No"],
    ["1H", "1I", "Yes"], ["1H", "notready", "No"],
    ["1I", "2A", "No"], ["1I", "owner", "Yes"],
    ["2A", "2B"], ["2A", "2C"], ["2A", "2D"],
    ["2B", "2E"], ["2C", "2E"], ["2D", "2E"],
    ["2E", "2F"], ["2F", "2G", "Yes"], ["2F", "li", "No"],
    ["2G", "2H"], ["2H", "3A", "Yes"], ["2H", "edits", "No"],
    ["3A", "3B"],
    ["3B", "o1"], ["3B", "o2"], ["3B", "o3"], ["3B", "o4"], ["3B", "o5"],
    ["o1", "a1"], ["o2", "a2"], ["o3", "a3"], ["o4", "a4"], ["o5", "a5"],
    ["a1", "3C"], ["3C", "3D"]
  ],
  "loop": {"from": "3D", "to": "1A", "label": "Weekly loop: results update the Context OS"}
}
